# ------------------------------------------------------------------------------
# 1. AI & LLM PROVIDER (Gemini 3.8 Flash / Vertex AI)
# ------------------------------------------------------------------------------
# Google Cloud project ID for Vertex AI (Gemini 3.8 Flash) & Firestore audit logging.
# Authenticate locally with: gcloud auth application-default login
# Or provide service account key via GOOGLE_APPLICATION_CREDENTIALS
GOOGLE_CLOUD_PROJECT=vayu-raksha-2026
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 2. VAYU-RAKSHA PYTHON GEO & CASCADE API SERVICE
# ------------------------------------------------------------------------------
# Backend endpoint running the 5-Agent LangGraph & NetworkX Cascade Engine
# Local development default: http://localhost:8000
GEO_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 3. GEOSPATIAL MAPS API (Optional)
# ------------------------------------------------------------------------------
# Google Maps JavaScript API key (restrict to http://localhost:3000 in GCP console).
# Note: VAYU-RAKSHA's 4D Tactical Command Map runs fully self-contained offline
# via vector GIS overlays even without a Google Maps key!
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------------------
# 4. SATELLITE RADAR & EARTH INTELLIGENCE (Optional Free Portals)
# ------------------------------------------------------------------------------
# ISRO MOSDAC API credentials (from https://mosdac.gov.in) for INSAT-3DS & Oceansat-3
ISRO_MOSDAC_API_KEY=

# ISRO Bhoonidhi token (from https://bhoonidhi.nrsc.gov.in) for RISAT-1A C-band SAR
ISRO_BHOONIDHI_TOKEN=

# Google Earth Engine service account email (for Sentinel-1 & NASADEM processing)
GEE_SERVICE_ACCOUNT=

# ------------------------------------------------------------------------------
# 5. SECURITY & AUDIT LOG SIGNING
# ------------------------------------------------------------------------------
# Cryptographic secret for signing official District Collector order authorizations.
# Generate in terminal: openssl rand -base64 32
TOOL_APPROVAL_SECRET=vayu_raksha_sec_token_prod_2026_demo

# On Vercel / Cloud deployment: keyless Workload Identity Federation
GCP_WORKLOAD_IDENTITY_PROVIDER=
GCP_SERVICE_ACCOUNT_EMAIL=
